// TRISHULA Levels — TradingView indicator (v1.0.0, 2 Nov 2026, app v0.23.0)
// Paste the line from TRISHULA → VS3D → Book → "TradingView paste" into any free "Day" field (10 days, any order).
// Draws each day's 09:35 Book levels across that day's session (latest day extends right):
//   main book   UP TEST green · DN TEST red · BALANCE white   — solid = locked, dashed = preview
//   single-leg  UP blue · DN magenta · BALANCE yellow          — dotted (faded = preview)
// plus the latest day's 09:35 profiles (main green/red, single-leg blue/magenta) to the right of the last bar.
// Prices in the paste are SPX. On ES / MES / SPX CFDs the levels are converted with the live chart ÷ SPX ratio
// (taken on bars where SPX trades, held overnight). No live data — TradingView scripts cannot read URLs.
//@version=6
indicator("TRISHULA Levels", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── inputs ──────────────────────────────────────────────────────────────────────────────────────────────
string GP = "Pastes (one TRISHULA line per day, any order)"
string p1  = input.text_area("", "Day 1",  group = GP)
string p2  = input.text_area("", "Day 2",  group = GP)
string p3  = input.text_area("", "Day 3",  group = GP)
string p4  = input.text_area("", "Day 4",  group = GP)
string p5  = input.text_area("", "Day 5",  group = GP)
string p6  = input.text_area("", "Day 6",  group = GP)
string p7  = input.text_area("", "Day 7",  group = GP)
string p8  = input.text_area("", "Day 8",  group = GP)
string p9  = input.text_area("", "Day 9",  group = GP)
string p10 = input.text_area("", "Day 10", group = GP)

string GM = "Main book levels"
bool  showMain = input.bool(true, "Show", group = GM)
color cUp  = input.color(#3fb950, "UP TEST",  group = GM)
color cDn  = input.color(#ef5350, "DN TEST",  group = GM)
color cBal = input.color(#e8ecf2, "BALANCE",  group = GM)

string GS = "Single-leg levels"
bool  showSL = input.bool(true, "Show", group = GS)
color sUp  = input.color(#1e90ff, "SL UP",      group = GS)
color sDn  = input.color(#ff00ff, "SL DN",      group = GS)
color sBal = input.color(#ffd600, "SL BALANCE", group = GS)

string GF = "Profiles (latest day, 09:35)"
bool  showProf = input.bool(true, "Show", group = GF)
int   profW    = input.int(40, "Width (bars)", minval = 5, maxval = 200, group = GF)
int   profGap  = input.int(3, "Gap after last bar (bars)", minval = 0, maxval = 100, group = GF)
color pPlus  = input.color(color.new(#26a69a, 30), "Main + (dealer long)",  group = GF)
color pMinus = input.color(color.new(#ef5350, 30), "Main − (dealer short)", group = GF)
color qPlus  = input.color(color.new(#1e90ff, 35), "Single-leg +", group = GF)
color qMinus = input.color(color.new(#ff00ff, 35), "Single-leg −", group = GF)

string GD = "Display"
bool showLabels = input.bool(true, "Labels (latest day)", group = GD)
int  lw         = input.int(2, "Line width", minval = 1, maxval = 5, group = GD)
string spxSym   = input.symbol("SP:SPX", "SPX reference", group = GD)

// ── SPX → this chart: ratio taken on bars where SPX itself prints, held while SPX is shut ───────────────────
float spxC = request.security(spxSym, timeframe.period, close)
int   spxT = request.security(spxSym, timeframe.period, time)
bool  isSpx = syminfo.ticker == "SPX"
var float ratio = na
if isSpx
    ratio := 1.0
else if not na(spxC) and spxC > 0 and spxT == time
    float r = close / spxC
    if r > 0.9 and r < 1.1
        ratio := r
float fallback = not na(spxC) and spxC > 0 and close / spxC > 0.9 and close / spxC < 1.1 ? close / spxC : 1.0
float k = na(ratio) ? fallback : ratio

// ── parsing ─────────────────────────────────────────────────────────────────────────────────────────────
type Lvl
    string kind
    float  px

type Day
    int   t0
    int   t1
    string date
    array<Lvl> main
    array<Lvl> sl
    bool  mainLocked
    bool  slLocked
    array<float> pk
    array<float> pv
    array<float> qk
    array<float> qv

parseLv(string body) =>
    array<Lvl> out = array.new<Lvl>()
    for it in str.split(body, ",")
        if str.length(it) > 1
            float v = str.tonumber(str.substring(it, 1))
            if not na(v)
                out.push(Lvl.new(str.substring(it, 0, 1), v))
    out

parseProf(string body, array<float> ks, array<float> vs) =>
    for it in str.split(body, ",")
        array<string> kv = str.split(it, ":")
        if kv.size() == 2
            float kk = str.tonumber(kv.get(0))
            float vv = str.tonumber(kv.get(1))
            if not na(kk) and not na(vv)
                ks.push(kk)
                vs.push(vv)
    ks.size()

parseDay(string raw) =>
    Day d = na
    string s = str.replace_all(str.replace_all(str.replace_all(raw, "\n", ""), "\r", ""), " ", "")
    if str.startswith(s, "TRI1|")
        array<string> f = str.split(s, "|")
        if f.size() >= 2 and str.length(f.get(1)) == 10
            string ds = f.get(1)
            int y  = int(str.tonumber(str.substring(ds, 0, 4)))
            int mo = int(str.tonumber(str.substring(ds, 5, 7)))
            int dd = int(str.tonumber(str.substring(ds, 8, 10)))
            d := Day.new(timestamp("America/New_York", y, mo, dd, 9, 30), timestamp("America/New_York", y, mo, dd, 16, 0), ds,
                         array.new<Lvl>(), array.new<Lvl>(), false, false,
                         array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())
            if f.size() > 2
                for i = 2 to f.size() - 1
                    string tok = f.get(i)
                    if str.length(tok) > 2
                        string key  = str.substring(tok, 0, 1)
                        string body = str.substring(tok, 2)
                        if key == "M" or key == "m"
                            d.main := parseLv(body)
                            d.mainLocked := key == "M"
                        else if key == "S" or key == "s"
                            d.sl := parseLv(body)
                            d.slLocked := key == "S"
                        else if key == "P"
                            parseProf(body, d.pk, d.pv)
                        else if key == "Q"
                            parseProf(body, d.qk, d.qv)
    d

// ── drawing (last bar only; everything is deleted and redrawn on each update) ──────────────────────────
var array<line>  LN = array.new<line>()
var array<label> LB = array.new<label>()
var array<box>   BX = array.new<box>()

drawLevels(Day d, array<Lvl> lv, bool locked, bool single, bool latest, float kk) =>
    for l in lv
        color c = single ? (l.kind == "U" ? sUp : l.kind == "D" ? sDn : sBal) : (l.kind == "U" ? cUp : l.kind == "D" ? cDn : cBal)
        color cc = single and not locked ? color.new(c, 45) : c
        string st = single ? line.style_dotted : (locked ? line.style_solid : line.style_dashed)
        float y = l.px * kk
        LN.push(line.new(d.t0, y, d.t1, y, xloc = xloc.bar_time, extend = latest ? extend.right : extend.none, color = cc, style = st, width = lw))
        if latest and showLabels
            string nm = (single ? "SL " : "") + (l.kind == "U" ? "UP" : l.kind == "D" ? "DN" : "BAL") + (locked ? "" : " (preview)")
            LB.push(label.new(bar_index, y, nm + "  " + str.tostring(y, "#.##") + " · SPX " + str.tostring(l.px, "#"),
                              style = label.style_label_right, color = color.new(color.black, 100), textcolor = cc, size = size.small))
    lv.size()

drawProfile(array<float> ks, array<float> vs, int x0, color cp, color cm, float kk) =>
    float mx = 0.0
    for v in vs
        mx := math.max(mx, math.abs(v))
    if mx > 0
        float hh = 2.0 * kk
        for [i, s_] in ks
            float v = vs.get(i)
            int w = math.max(1, int(math.round(math.abs(v) / mx * profW)))
            BX.push(box.new(x0, s_ * kk + hh, x0 + w, s_ * kk - hh, border_color = color(na), bgcolor = v >= 0 ? cp : cm))
    ks.size()

if barstate.islast
    for x in LN
        x.delete()
    for x in LB
        x.delete()
    for x in BX
        x.delete()
    LN.clear()
    LB.clear()
    BX.clear()
    array<Day> days = array.new<Day>()
    for s in array.from(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10)
        Day d = parseDay(s)
        if not na(d)
            days.push(d)
    int latestT = 0
    for d in days
        latestT := math.max(latestT, d.t0)
    for d in days
        bool latest = d.t0 == latestT
        if showMain
            drawLevels(d, d.main, d.mainLocked, false, latest, k)
        if showSL
            drawLevels(d, d.sl, d.slLocked, true, latest, k)
        if latest and showProf
            drawProfile(d.pk, d.pv, bar_index + profGap, pPlus, pMinus, k)
            drawProfile(d.qk, d.qv, bar_index + profGap + profW + 3, qPlus, qMinus, k)
